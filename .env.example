# Environment variables (copy to `.env.local`)

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# YouTube Data API (discovery + measurement crons only)
YOUTUBE_API_KEY=

# Vercel/manual cron HTTP routes
CRON_SECRET=

# Admin API
ADMIN_SECRET=

# Local migration apply (optional — Supabase Dashboard SQL Editor also works)
SUPABASE_DB_PASSWORD=

# Phase1 speed verification window (GitHub Actions sets this)
PHASE1_6H_CRON_START_ISO=2026-07-27T18:00:00.000Z

# Phase2 WebSub (default OFF — enable only for Step 6B canary)
WEBSUB_ENABLED=false
WEBSUB_HUB_SECRET=
WEBSUB_APP_DOMAIN=
WEBSUB_CANARY_MAX_CHANNELS=0
WEBSUB_HUB_URL=https://pubsubhubbub.appspot.com/subscribe
WEBSUB_SAFETY_POLL_INTERVAL_HOURS=24
WEBSUB_LEASE_BUFFER_HOURS=48
WEBSUB_VERIFY_STALE_DAYS=7
WEBSUB_LEASE_REQUEST_SECONDS=604800
WEBSUB_PENDING_VERIFY_STALE_HOURS=48
WEBSUB_MAX_SUBSCRIBE_ATTEMPTS=5
WEBSUB_SUBSCRIBE_BATCH_LIMIT=200
WEBSUB_SUBSCRIBE_CONCURRENCY=10
WEBSUB_URGENT_RENEW_WITHIN_HOURS=72
WEBSUB_DAILY_RENEW_WITHIN_DAYS=7
WEBSUB_WORKER_BATCH_SIZE=50
WEBSUB_WORKER_MAX_BATCHES_PER_RUN=4
WEBSUB_WORKER_PROCESSING_LEASE_SECONDS=600
